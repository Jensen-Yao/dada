# =====================================================================
# 搭搭 App — 裸机部署（不用 Docker）systemd 单元示例
# =====================================================================
# 前提：服务器已装 Node.js 22+（本单元假定其在 /usr/bin/node，可用
#       `command -v node` 确认，不符则修改 ExecStart）；代码部署在 /opt/dada
#
# 安装步骤：
#   sudo useradd -r -s /usr/sbin/nologin dada          # 专用低权用户
#   sudo mkdir -p /var/lib/dada /opt/dada/server/data  # 数据目录与上传目录
#   sudo chown -R dada:dada /var/lib/dada /opt/dada/server/data
#   sudo cp deploy/systemd-example.service /etc/systemd/system/dada.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dada
#
# 日常运维：
#   journalctl -u dada -f          # 看日志
#   sudo systemctl restart dada    # 重启（升级后）
#   curl -fsS http://127.0.0.1:3000/api/meta   # 健康检查
#
# 首次运行应用自建空库；演示数据（仅内网/演示环境）：
#   cd /opt/dada/server && sudo -u dada DADA_DB=/var/lib/dada/dada.sqlite node src/seed.js
# =====================================================================

[Unit]
Description=dada (搭搭) App server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dada
Group=dada
WorkingDirectory=/opt/dada/server
ExecStart=/usr/bin/node /opt/dada/server/src/index.js

# —— 环境变量 ——
Environment=DADA_PORT=3000
Environment=DADA_DB=/var/lib/dada/dada.sqlite
Environment=NODE_ENV=production
# 生产必须设置 JWT 签名密钥（生成：openssl rand -hex 32）：
# Environment=DADA_JWT_SECRET=please-change-me-to-a-long-random-string

# —— 稳定性 ——
Restart=always
RestartSec=3

# —— 轻度加固（可选，按发行版支持情况取舍）——
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/dada /opt/dada/server/data

[Install]
WantedBy=multi-user.target
